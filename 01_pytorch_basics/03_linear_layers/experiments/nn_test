import torch
import torch.nn as nn

layer = nn.Linear(2, 1)

with torch.no_grad():
    layer.weight.copy_(torch.tensor([[2.0, 3.0]]))
    layer.bias.copy_(torch.tensor([1.0]))

x = torch.tensor([4.0, 5.0])

target = torch.tensor([30.0])

optimizer = torch.optim.SGD(layer.parameters(),lr=0.01)

for i in range(10):
    optimizer.zero_grad()
    y = layer(x)
    loss = (y-target)**2
    loss.backward()
    optimizer.step()
    print(y)
    print(loss)

print(layer.weight)
print(layer.bias)